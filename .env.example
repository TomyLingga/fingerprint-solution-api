# ---- HTTP server ----
PORT=3000

# ---- Sumber data ----
# device = tarik langsung dari mesin fingerprint (produksi)
# excel  = baca file hasil export Attendance Management (untuk uji coba offline)
DATA_SOURCE=device

# ---- Daftar mesin fingerprint ----
# Semua mesin didaftarkan di devices.json. Ubah berkas itu lalu panggil
# POST /api/v1/devices/reload untuk menerapkannya tanpa restart.
DEVICES_FILE=./devices.json

# ---- Nilai bawaan per mesin (protokol ZKTeco / Solution) ----
# Dipakai untuk field yang tidak diisi di devices.json. Bila devices.json tidak
# ada sama sekali, DEVICE_IP dan DEVICE_PORT di bawah dipakai sebagai satu mesin.
DEVICE_IP=192.168.1.210
DEVICE_PORT=4370
DEVICE_TIMEOUT=10000
# Port UDP lokal untuk fallback. Mesin kedua dan seterusnya otomatis memakai
# nilai ini ditambah urutannya, supaya tidak bentrok.
DEVICE_INPORT=5200
# Penyetelan unduhan massal (chunk diminta satu per satu ke mesin)
DEVICE_CHUNK_TIMEOUT=20000
DEVICE_CHUNK_SIZE=65472
DEVICE_CHUNK_RETRIES=2

# ---- Sumber Excel (dipakai saat DATA_SOURCE=excel) ----
EXCEL_FILE=./Sample Absensi.xls

# ---- Cache ----
# Mesin tidak bisa memfilter tanggal di sisi perangkat: seluruh log harus
# diunduh lalu difilter di API. Cache menahan hasil unduhan selama N detik.
CACHE_TTL_SECONDS=300
# Snapshot disimpan ke disk agar restart tidak perlu unduh ulang dari nol,
# dan agar unduhan yang terputus tetap terakumulasi. Satu berkas per mesin,
# disimpan di <CACHE_DIR>/devices/<id>.json
CACHE_PERSIST=true
CACHE_DIR=./data

# ---- Sinkronisasi terjadwal ----
# Scheduler menarik data dari mesin di latar belakang supaya cache selalu hangat.
# Tanpa ini, request pertama setelah cache kedaluwarsa harus menunggu unduhan
# penuh yang memakan sekitar satu menit.
SYNC_ENABLED=true
# Jeda antar sinkronisasi, dihitung setelah sinkronisasi sebelumnya selesai.
# Samakan dengan CACHE_TTL_SECONDS agar cache tidak pernah sempat basi.
SYNC_INTERVAL_SECONDS=300
# Jeda sebelum sinkronisasi pertama setelah server hidup.
SYNC_INITIAL_DELAY_SECONDS=2

# ---- Paginasi ----
DEFAULT_PAGE_SIZE=1000
MAX_PAGE_SIZE=10000

# ---- Zona waktu ----
# Wajib sama dengan zona waktu mesin fingerprint.
TZ=Asia/Jakarta
