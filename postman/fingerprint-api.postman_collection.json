    {
      "name": "05 - Rekap harian",
      "description": "Log mentah yang sudah diringkas menjadi jam masuk dan jam pulang.",
      "item": [
        {
          "name": "Rekap harian - rentang tanggal",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/attendance/daily?start={{start}}&end={{end}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "attendance",
                "daily"
              ],
              "query": [
                {
                  "key": "start",
                  "value": "{{start}}",
                  "description": "Awal rentang. Format YYYY-MM-DD atau YYYY-MM-DD HH:mm:ss. Tanpa jam berarti 00:00:00."
                },
                {
                  "key": "end",
                  "value": "{{end}}",
                  "description": "Akhir rentang. Format YYYY-MM-DD atau YYYY-MM-DD HH:mm:ss. Tanpa jam berarti 23:59:59."
                },
                {
                  "key": "deviceId",
                  "value": "{{deviceId}}",
                  "description": "Filter per mesin. Bisa banyak, dipisah koma. Kosong berarti semua mesin.",
                  "disabled": true
                },
                {
                  "key": "userId",
                  "value": "{{userId}}",
                  "description": "Filter No.ID karyawan. Bisa banyak, dipisah koma: 200,201,238",
                  "disabled": true
                },
                {
                  "key": "order",
                  "value": "asc",
                  "description": "Urutan waktu: asc atau desc. Default asc.",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Halaman, dimulai dari 1.",
                  "disabled": true
                },
                {
                  "key": "limit",
                  "value": "1000",
                  "description": "Jumlah baris per halaman. Default 1000, maksimal 10000.",
                  "disabled": true
                }
              ]
            },
            "description": "Satu baris per karyawan per tanggal: scan pertama sebagai jam masuk, scan terakhir sebagai jam pulang.\n\nPengelompokan sengaja mengabaikan mesin mana yang merekam, jadi karyawan yang\nmasuk lewat satu gerbang dan pulang lewat gerbang lain tetap menghasilkan satu\nbaris yang benar. Field deviceIds menyebut mesin mana saja yang terlibat.\n\ncheckOut dan durationMinutes bernilai null bila karyawan hanya scan sekali pada tanggal tersebut."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"Permintaan berhasil\", function () {",
                  "  pm.expect(pm.response.code, body.message || \"\").to.eql(200);",
                  "});",
                  "",
                  "if (body.success) {",
                  "  pm.test(\"Jam pulang tidak mendahului jam masuk\", function () {",
                  "    body.data.forEach(function (row) {",
                  "      if (row.checkOut) {",
                  "        pm.expect(row.checkOut >= row.checkIn, row.userId + \" \" + row.date).to.be.true;",
                  "      }",
                  "    });",
                  "  });",
                  "",
                  "  pm.test(\"Hasil mencakup semua mesin aktif\", function () {",
                  "    pm.expect(body.meta.pendingDevices, \"mesin yang belum sync\").to.be.an(\"array\").that.is.empty;",
                  "  });",
                  "",
                  "  body.meta.devices.filter(function (d) { return d.error; }).forEach(function (d) {",
                  "    console.warn(\"Mesin bermasalah:\", d.deviceId, d.error);",
                  "  });",
                  "",
                  "  const sekaliScan = body.data.filter(function (row) { return row.totalScan === 1; });",
                  "  const lintasMesin = body.data.filter(function (row) { return row.deviceIds.length > 1; });",
                  "  if (sekaliScan.length) console.warn(\"Karyawan yang hanya scan sekali:\", sekaliScan.length, \"baris\");",
                  "  if (lintasMesin.length) console.log(\"Hari kerja yang memakai lebih dari satu mesin:\", lintasMesin.length, \"baris\");",
                  "}"
                ]
              }
            }
          ]
        },
