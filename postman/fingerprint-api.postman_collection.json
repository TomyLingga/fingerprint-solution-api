            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/attendance?start={{start}}&end={{end}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "attendance"
              ],
              "query": [
                {
                  "key": "start",
                  "value": "{{start}}",
                  "description": "Awal rentang. Format YYYY-MM-DD atau YYYY-MM-DD HH:mm:ss. Tanpa jam berarti 00:00:00."
                },
                {
                  "key": "end",
                  "value": "{{end}}",
                  "description": "Akhir rentang. Format YYYY-MM-DD atau YYYY-MM-DD HH:mm:ss. Tanpa jam berarti 23:59:59."
                },
                {
                  "key": "deviceId",
                  "value": "{{deviceId}}",
                  "description": "Filter per mesin. Bisa banyak, dipisah koma. Kosong berarti semua mesin.",
                  "disabled": true
                },
                {
                  "key": "userId",
                  "value": "{{userId}}",
                  "description": "Filter No.ID karyawan. Bisa banyak, dipisah koma: 200,201,238",
                  "disabled": true
                },
                {
                  "key": "name",
                  "value": "",
                  "description": "Cari nama karyawan, tidak peka huruf besar/kecil.",
                  "disabled": true
                },
                {
                  "key": "order",
                  "value": "asc",
                  "description": "Urutan waktu: asc atau desc. Default asc.",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Halaman, dimulai dari 1.",
                  "disabled": true
                },
                {
                  "key": "limit",
                  "value": "1000",
                  "description": "Jumlah baris per halaman. Default 1000, maksimal 10000.",
                  "disabled": true
                },
                {
                  "key": "refresh",
                  "value": "true",
                  "description": "Isi true untuk memaksa tarik ulang dari semua mesin dan mengabaikan cache.",
                  "disabled": true
                }
              ]
            },
            "description": "Log absensi mentah dari semua mesin, digabung dan diurutkan menurut waktu.\nIni endpoint utama untuk integrasi ke Talenta.\n\nPerhatikan meta.complete pada respons. Nilainya false berarti ada mesin\naktif yang belum pernah tersinkronisasi, jadi hasilnya belum lengkap."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"Permintaan berhasil\", function () {",
                  "  pm.expect(pm.response.code, body.message || \"\").to.eql(200);",
                  "});",
                  "",
                  "// Pemeriksaan isi hanya masuk akal bila server benar-benar membalas data.",
                  "if (body.success) {",
                  "  pm.test(\"Rentang pada meta sesuai permintaan\", function () {",
                  "    pm.expect(body.meta.start).to.include(pm.variables.get(\"start\"));",
                  "    pm.expect(body.meta.end).to.include(pm.variables.get(\"end\"));",
                  "  });",
                  "",
                  "  pm.test(\"Setiap log punya userId, timestamp, dan asal mesin\", function () {",
                  "    body.data.forEach(function (row) {",
                  "      pm.expect(row).to.have.property(\"userId\");",
                  "      pm.expect(row.deviceId, \"deviceId\").to.be.a(\"string\").and.not.empty;",
                  "      pm.expect(row.timestamp).to.match(/^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$/);",
                  "    });",
                  "  });",
                  "",
                  "  pm.test(\"Hasil mencakup semua mesin aktif\", function () {",
                  "    pm.expect(body.meta.pendingDevices, \"mesin yang belum sync\").to.be.an(\"array\").that.is.empty;",
                  "  });",
                  "",
                  "  body.meta.devices.filter(function (d) { return d.error; }).forEach(function (d) {",
                  "    console.warn(\"Mesin bermasalah:\", d.deviceId, d.error);",
                  "  });",
                  "",
                  "  const perMesin = {};",
                  "  body.data.forEach(function (row) { perMesin[row.deviceId] = (perMesin[row.deviceId] || 0) + 1; });",
                  "  console.log(\"Total log cocok:\", body.meta.total, \"| sebaran halaman ini:\", JSON.stringify(perMesin));",
                  "}"
                ]
              }
            }
          ]
        },
